# 참가자 설정 — 시크릿 아님 (커밋됨). 값을 바꾼 뒤 docker compose up -d 로 재적용.

# 이미지 태그 — run/setup.sh 가 이 이름으로 여러분 머신에서 굽습니다 (레지스트리 아님).
CHALLENGE_IMAGE=humanoid-challenge-env:latest

# Isaac Sim EULA — 본인이 NVIDIA Omniverse EULA 에 동의하면 Y 로 설정하세요.
# 비어 있으면 시뮬레이터가 뜨지 않습니다.
ACCEPT_EULA=Y

# 이미지 안 경로 (바꿀 일 없음)
DOCKER_ISAACSIM_ROOT_PATH=/isaac-sim
DOCKER_CYCLOLAB_PATH=/workspace/cyclo_lab
DOCKER_ISAACLAB_PATH=/workspace/cyclo_lab/third_party/IsaacLab
DOCKER_USER_HOME=/root
